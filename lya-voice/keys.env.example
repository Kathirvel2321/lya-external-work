# Lya keys - copy this file to "keys.env" and paste your keys after the "=".
#
#   copy keys.env.example keys.env
#   notepad keys.env
#
# Rules:
#   * This file is OPTIONAL. The free voice engine (Microsoft Edge voices via
#     edge-tts) needs NO key at all. Lya already talks without this file.
#   * Anything you leave empty is simply skipped.
#   * A real Windows environment variable always wins over a line in this file.
#   * Do not share this file or paste it into a chat/screenshot.
#   * Add "keys.env" to your backup ignore list; keys can be billed.

# ---------------------------------------------------------------------------
# 1. Sarvam AI - unlocks the Bulbul voice engine AND Tamil speech-to-text
#    Get it: https://dashboard.sarvam.ai  (new accounts get free credits)
#    Cost:   Rs 30 per 10,000 characters of speech, Rs 30/hour of listening
#    Used by: lya_voice.py --engine sarvam, lya_chat.py --mic
# ---------------------------------------------------------------------------
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# 2. Brain for lya_chat.py - any OpenAI-compatible endpoint.
#    Without this, lya_chat.py uses the offline echo brain (still testable).
#    Pick ONE of the free options below and uncomment its two lines.
# ---------------------------------------------------------------------------

# --- Google Gemini (free tier available) ---
#    base_url confirmed from Google's OpenAI-compatibility docs
#LYA_BRAIN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#LYA_BRAIN_API_KEY=your-gemini-api-key
#LYA_BRAIN_MODEL=gemini-3.8-flash

# --- NVIDIA NIM (free developer tier) - dashboard at build.nvidia.com ---
#LYA_BRAIN_BASE_URL=https://integrate.api.nvidia.com/v1
#LYA_BRAIN_API_KEY=nvapi-your-key
#LYA_BRAIN_MODEL=meta/llama-3.1-8b-instruct

# --- Groq (free tier, very fast) ---
#LYA_BRAIN_BASE_URL=https://api.groq.com/openai/v1
#LYA_BRAIN_API_KEY=gsk_your-key
#LYA_BRAIN_MODEL=llama-3.3-70b-versatile

# --- Ollama on your own laptop (no key, no internet) ---
#LYA_BRAIN_BASE_URL=http://localhost:11434/v1
#LYA_BRAIN_API_KEY=ollama
#LYA_BRAIN_MODEL=llama3.2
